# ---- LLM (Groq) -------------------------------------------------------------
# Get a key at https://console.groq.com/keys . Groq has a free tier, but usage
# limits and pricing are set by Groq and can change - check your Groq account.
LLM_PROVIDER=groq
GROQ_API_KEY=
# llama-3.3-70b-versatile was retired by Groq on 16 Aug 2026. Model names change over time:
# see https://console.groq.com/docs/models and https://console.groq.com/docs/deprecations
GROQ_MODEL=openai/gpt-oss-120b
# Only used by gpt-oss reasoning models. low = fastest and cheapest, high = most thorough.
GROQ_REASONING_EFFORT=low
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=60

# ---- Embeddings (free, local) ----------------------------------------------
# "sentence-transformers" downloads the model once (~90 MB) from Hugging Face.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Storage (defaults to ../data relative to the repo) ---------------------
# DATA_DIR=../data
# SQLITE_PATH=../data/app.db
# UPLOAD_DIR=../data/uploads
# CHROMA_DIR=../data/chroma

# ---- Limits and tuning ------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_FILES_PER_REQUEST=10
CHUNK_TARGET_TOKENS=180
CHUNK_MAX_TOKENS=250
CHUNK_OVERLAP_TOKENS=50
TOP_K=5
MIN_SCORE=0.25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
